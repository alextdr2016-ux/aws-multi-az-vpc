region      = "eu-north-1"
environment = "dev"

vpc_cidr = "10.0.0.0/16"

availability_zones = ["eu-north-1a", "eu-north-1b", "eu-north-1c"]

public_subnet_cidrs = [
  "10.0.1.0/24",
  "10.0.2.0/24",
  "10.0.3.0/24"
]

private_subnet_cidrs = [
  "10.0.11.0/24",
  "10.0.12.0/24",
  "10.0.13.0/24"
]

database_subnet_cidrs = [
  "10.0.21.0/24",
  "10.0.22.0/24",
  "10.0.23.0/24"
]

enable_nat_gateway = true
single_nat_gateway = false
enable_flow_logs   = true